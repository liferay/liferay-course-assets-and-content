INSERT INTO FRAGMENTENTRYLINK VALUES(20,0,'0d175b9e-f158-9a71-b8af-fd207ba012de','0d175b9e-f158-9a71-b8af-fd207ba012de',66523,32106,16796623585306,20122,'Clarity Admin','2025-09-22 14:31:21.000000','2026-05-07 19:27:08.327000','e7674d21-7485-1f82-9502-3714e1b6b1cb','','',65019,20031,142,142,'.component-paragraph img {\u000a\u0009max-width: 100%;\u000a}','<div class="clearfix component-paragraph text-break" data-lfr-editable-id="element-text" data-lfr-editable-type="rich-text">\u000a\u0009<p>\u000a\u0009\u0009A paragraph is a self-contained unit of a discourse in writing dealing with\u000a\u0009\u0009a particular point or idea. Paragraphs are usually an expected part of\u000a\u0009\u0009formal writing, used to organize longer prose.\u000a\u0009</p>\u000a</div>','','','0','{"com.liferay.fragment.entry.processor.editable.EditableFragmentEntryProcessor":{"element-text":{"defaultValue":"\n\t<p>\n\t\tA paragraph is a self-contained unit of a discourse in writing dealing with\n\t\ta particular point or idea. Paragraphs are usually an expected part of\n\t\tformal writing, used to organize longer prose.\n\t<\/p>\n\n\n","en_US":"Clarity is an eyeglass and contact lens manufacturer that sells directly to consumer brands. We redefine Clarity through precision-crafted eyewear. Explore our curated selection of stylish frames, expertly desgined to enhance your vision and style.","config":{"mapperType":"link"}}}}','sazk',1,'BASIC_COMPONENT-paragraph',1,'2026-05-07 19:26:16.652000',NULL)
